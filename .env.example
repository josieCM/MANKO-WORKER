# Copy to .env and fill in real values. Never commit .env.

# Base44 control plane
BASE44_API_BASE_URL=https://session-sphere-flow.base44.app
# This worker's URL as reachable from Base44's servers (port-forward or tunnel)
BASE44_WORKER_ENDPOINT=
WORKER_SHARED_SECRET=replace-with-the-base44-worker-shared-secret
# Reserved for the remote-viewer phase (unused today)
VIEWER_TOKEN_HMAC_KEY=

# Worker identity
WORKER_ID=worker-01

# Session (POC supports exactly one)
SESSION_ID=6a97b86f
SESSION_TARGET_URL=https://sportpesa.co.tz/en/casino/aviator
ALLOWED_URL_PREFIXES=https://sportpesa.co.tz

# Local command endpoint
HOST=127.0.0.1
PORT=3939

# Runtime tuning
HEADLESS=false
MAX_SESSIONS=1
SESSIONS_DIR_NAME=sessions
LOG_DIR_NAME=worker-logs
HEARTBEAT_INTERVAL_MS=10000
ACK_DELAY_MS=2500
NAVIGATION_TIMEOUT_MS=45000
CRASH_MAX_RECOVERY_ATTEMPTS=2
