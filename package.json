{
  "name": "manko-browser-worker",
  "version": "1.0.0-alpha",
  "description": "MANKO Worker v1 Alpha - Local browser-execution worker for the Base44 Browser Control Plane. Infrastructure only - no betting/automation logic.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "verify": "node scripts/verify-signing.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "jest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "keytar": "^7.9.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.manko.worker",
    "productName": "MANKO Worker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MANKO Worker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers/chromium-*/chrome-win",
        "to": "chromium",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "electron@29.4.6": true
  }
}
